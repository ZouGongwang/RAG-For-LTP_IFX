# Copy to .env and fill in. .env is git-ignored.

# --- Confluence (only needed when sources.confluence_api.enabled: true) ---
# Data Center/Server: base URL incl. context path, and a Personal Access Token
#   (Profile > Personal Access Tokens). Leave CONFLUENCE_USER empty.
# Cloud: https://<site>.atlassian.net/wiki, your email, and an API token from
#   https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_URL=
CONFLUENCE_TOKEN=
CONFLUENCE_USER=

# --- Company LiteLLM gateway (chat answers + vision captions) ---
# One key usually covers gpt-5, claude-sonnet-4.6, and embeddings on the gateway.
LLM_API_KEY=

# Corporate CA bundle from the LiteLLM doc (download ca-bundle.crt, then set the path).
# The OpenAI client in rag/llm/openai_compat.py passes this to httpx as verify=.
# SSL_CERT_FILE=/Users/you/Secrets/ca-bundle.crt
# REQUESTS_CA_BUNDLE=/Users/you/Secrets/ca-bundle.crt

# --- Optional MCP (only if IT requires MCP instead of OpenAI-compat) ---
MCP_AUTH_TOKEN=

# --- Optional overrides of config.yaml ---
# RAG_LLM__OPENAI_COMPAT__MODEL=claude-sonnet-4.6
# RAG_VISION__OPENAI_COMPAT__MODEL=claude-sonnet-4.6
# RAG_LLM__OPENAI_COMPAT__BASE_URL=https://litellm.icp.infineon.com/v1
# RAG_LLM__PROVIDER=ollama
# RAG_DEVICE=cpu
